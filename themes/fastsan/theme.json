{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,

	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,

		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},

		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "Base (paper)" },
				{ "slug": "base-muted", "color": "#FAF7F2", "name": "Base Muted (cream)" },
				{ "slug": "contrast", "color": "#1A1A1A", "name": "Contrast (ink)" },
				{ "slug": "secondary-text", "color": "#4A4A4A", "name": "Secondary Text" },
				{ "slug": "tertiary-text", "color": "#666666", "name": "Tertiary Text (WCAG-AA)" },
				{ "slug": "text-inverse", "color": "#F5E9D7", "name": "Text Inverse (sandstone-pale)" },
				{ "slug": "primary", "color": "#15324A", "name": "Primary (navy)" },
				{ "slug": "primary-dark", "color": "#0E2235", "name": "Primary Dark (navy-deep)" },
				{ "slug": "primary-light", "color": "#2A4F6F", "name": "Primary Light (navy-light)" },
				{ "slug": "accent", "color": "#B5824A", "name": "Accent (sandstone)" },
				{ "slug": "accent-text", "color": "#8B6035", "name": "Accent Text (WCAG-AA, 4.86:1)" },
				{ "slug": "accent-soft", "color": "#D4A574", "name": "Accent Soft (sandstone-light)" },
				{ "slug": "accent-pale", "color": "#F5E9D7", "name": "Accent Pale (sandstone-pale)" },
				{ "slug": "border", "color": "#E5DDD0", "name": "Border" },
				{ "slug": "alert", "color": "#B33A2C", "name": "Alert (WCAG-AA)" },
				{ "slug": "alert-soft", "color": "#F9E7E4", "name": "Alert Soft" },
				{ "slug": "success", "color": "#4A7C59", "name": "Success" }
			],
			"gradients": [
				{
					"slug": "hero-cream",
					"gradient": "linear-gradient(180deg, #FAF7F2 0%, #FFFFFF 100%)",
					"name": "Hero Cream"
				},
				{
					"slug": "cta-stack-navy",
					"gradient": "linear-gradient(135deg, #15324A 0%, #0E2235 100%)",
					"name": "CTA Stack Navy"
				},
				{
					"slug": "alert-fade",
					"gradient": "linear-gradient(180deg, #F9E7E4 0%, #FFFFFF 100%)",
					"name": "Alert Fade"
				}
			]
		},

		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"slug": "display",
					"name": "Display (Schibsted Grotesk)",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"fontFamily": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"slug": "body",
					"name": "Body (Inter)",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "size": "0.85rem", "name": "X-Small", "fluid": { "min": "0.8125rem", "max": "0.875rem" } },
				{ "slug": "small", "size": "0.95rem", "name": "Small", "fluid": { "min": "0.875rem", "max": "0.95rem" } },
				{ "slug": "medium", "size": "1.05rem", "name": "Medium (body)", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "size": "1.15rem", "name": "Large (lead)", "fluid": { "min": "1.0625rem", "max": "1.2rem" } },
				{ "slug": "x-large", "size": "1.3rem", "name": "X-Large (h3)", "fluid": { "min": "1.2rem", "max": "1.3rem" } },
				{ "slug": "xx-large", "size": "2rem", "name": "XX-Large (h2)", "fluid": { "min": "1.6rem", "max": "2.2rem" } },
				{ "slug": "lead", "size": "1.25rem", "name": "Lead (ingress)", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "section", "size": "2.5rem", "name": "Section (startsidans h2)", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "hero", "size": "3.4rem", "name": "Hero (h1)", "fluid": { "min": "2rem", "max": "3.4rem" } },
				{ "slug": "display", "size": "3.875rem", "name": "Display (startsidans h1)", "fluid": { "min": "2.375rem", "max": "3.875rem" } }
			]
		},

		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "size": "clamp(0.25rem, 0.5vw, 0.5rem)", "name": "2XS" },
				{ "slug": "20", "size": "clamp(0.5rem, 1vw, 0.75rem)", "name": "XS" },
				{ "slug": "30", "size": "clamp(0.75rem, 1.5vw, 1rem)", "name": "S" },
				{ "slug": "40", "size": "clamp(1rem, 2vw, 1.5rem)", "name": "M" },
				{ "slug": "50", "size": "clamp(1.5rem, 3vw, 2.5rem)", "name": "L" },
				{ "slug": "60", "size": "clamp(2rem, 4vw, 3rem)", "name": "XL" },
				{ "slug": "70", "size": "clamp(3rem, 6vw, 4.5rem)", "name": "2XL" },
				{ "slug": "80", "size": "clamp(4rem, 8vw, 6rem)", "name": "3XL" }
			]
		},

		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		},

		"custom": {
			"radius": {
				"sm": "4px",
				"md": "8px",
				"mid": "12px",
				"lg": "16px",
				"xl": "20px",
				"pill": "9999px"
			},
			"shadow": {
				"sm": "0 1px 2px rgba(21, 50, 74, 0.06)",
				"md": "0 4px 16px rgba(21, 50, 74, 0.08)",
				"lg": "0 12px 32px rgba(21, 50, 74, 0.12)",
				"xl": "0 30px 60px rgba(3, 12, 24, 0.45)"
			}
		}
	},

	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "800",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "800"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-text)"
					}
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			}
		}
	},

	"customTemplates": [
		{
			"name": "front-page",
			"title": "Front Page (Fastsan)",
			"postTypes": ["page"]
		},
		{
			"name": "service-page",
			"title": "Service Page (med sidebar)",
			"postTypes": ["page"]
		},
		{
			"name": "blank",
			"title": "Blank (Full Width)",
			"postTypes": ["page", "post"]
		}
	],

	"templateParts": [
		{
			"name": "header",
			"title": "Header (akut-strip + logo + nav)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (NAP-grid)",
			"area": "footer"
		}
	]
}
